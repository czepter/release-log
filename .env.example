# Copy to .env and fill in. Every variable in the first block is required;
# the service refuses to start and names all missing ones at once.

# --- GitHub App (Settings -> Developer settings -> GitHub Apps) ----------
# The app ID, a number.
GITHUB_APP_ID=
# The app's private key, PEM, base64-encoded in one line:
#   base64 -w0 your-app.private-key.pem      (macOS: base64 -i ... )
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set on the app.
GITHUB_WEBHOOK_SECRET=
# The app's OAuth identity, for signing humans in. Same settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- This instance -------------------------------------------------------
# The public base URL, no trailing slash. GitHub redirects back here.
BASE_URL=https://releases.example.com
# Signs the session cookie:  openssl rand -hex 32
SIGNING_KEY=
# Encrypts the GitHub user tokens at rest, 32 bytes:  openssl rand -hex 32
# Losing it logs everyone out; changing it does the same.
TOKEN_ENCRYPTION_KEY=
# GitHub logins with admin rights, comma-separated. At least one, otherwise
# nobody can ever get in.
ADMIN_LOGINS=your-github-login

# --- Optional ------------------------------------------------------------
# Port of the service. The container image defaults to 3000.
#PORT=3000
# Where the SQLite index lives. The container image defaults to
# /data/release-log.sqlite; outside a container it is ./data/release-log.sqlite
#DB_PATH=/data/release-log.sqlite
# Where the migrations live. The container image sets this to /app/drizzle,
# because the bundled server no longer sits next to the folder.
#MIGRATIONS_DIR=/app/drizzle
# 1 lets every GitHub account sign in and skips the allowlist entirely.
#OPEN_SIGNUP=1
# How many logs one repository owner may keep. 0 lifts the limit.
#MAX_LOGS_PER_OWNER=10
# Embeds one public log's changelog into the landing page, cached 5 minutes.
#RL_SHOWCASE_URL=https://releases.example.com/l/some-log

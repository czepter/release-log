{
  "name": "release-log-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "test": "node --test --test-timeout=30000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "reindex": "node --env-file-if-exists=.env bin/reindex.ts",
    "dev": "RL_DEV_FAKE=1 nuxt dev web",
    "build": "nuxt build web",
    "start:web": "node web/.output/server/index.mjs",
    "postinstall": "nuxt prepare web"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/paragraph": "^2.11.7",
    "@lucide/vue": "^1.46.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.2.0"
  }
}
